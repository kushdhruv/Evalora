# ==============================================================================
# Agent Evaluation & Observability Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Local persistent SQLite database stored in data/aieval.db
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aieval
DATABASE_URL=sqlite:///data/aieval.db

# ------------------------------------------------------------------------------
# 2. LLM JUDGE PROVIDER KEYS (Choose one or more, or leave empty for free local fallback)
# ------------------------------------------------------------------------------

# Option A: Google Gemini (Recommended - generous free tier & fast inference)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: OpenAI (GPT-4o, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option C: Anthropic (Claude 3.5 Sonnet)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Option D: Groq (Ultra-fast Llama-3.3-70b)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Option E: Local Offline Ollama (100% Free, No API key required)
# Install: https://ollama.com -> 'ollama run llama3:8b'
OLLAMA_API_BASE=http://localhost:11434

# Active Judge Model Selection (e.g., 'gemini/gemini-2.5-flash', 'gpt-4o-mini', 'claude-3-5-haiku', 'ollama/llama3:8b')
LLM_JUDGE_MODEL=gemini/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. SERVER & CI GATE SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
AI_EVAL_SCORE_THRESHOLD=0.85
AI_EVAL_MAX_LATENCY_MS=5000.0
