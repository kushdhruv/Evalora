# ==============================================================================
# Git Ignore - Agent Evaluation & Observability Platform
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SENSITIVE API KEYS)
.env
.env.local
*.env
!.env.example

# Documentation (kept local, excluded from public repo per user request)
docs/

# Databases & SQLite WAL files
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
*.db

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
venv/
.venv/
env/
ENV/

# Node / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
